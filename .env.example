# Copia este archivo a .env y rellena tus valores reales.
# El .env NO se sube al repositorio (está en .gitignore).

# Token de la API de Fixner (se envía como "Authorization: Bearer <TOKEN>")
FIXNER_TOKEN=pon-aqui-tu-token

# ID de la obra (project-id) sobre la que se listan las OT
PROJECT_ID=pon-aqui-el-id-de-la-obra

# ID del operario al que se le imputan las horas (solo necesario para el FLUJO 2)
WORKER_ID=pon-aqui-el-id-del-operario
